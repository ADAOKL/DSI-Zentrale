# MiningVZ Backend Configuration Example
# Kopiere diese Datei nach .env und passe die Werte an

# Server Port (Standard: 8000)
PORT=8000

# JWT Secret für Token-Signing
# WICHTIG: Für Production einen sicheren zufälligen String generieren!
# Kommando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_secret_here

# Environment (development|production)
NODE_ENV=development
